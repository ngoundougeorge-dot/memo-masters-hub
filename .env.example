# ==============================================================================
# CONFIGURATION DES VARIABLES D'ENVIRONNEMENT DE PRODUCTION — MÉMOIREPRO GABON
# ==============================================================================
# Copiez ce fichier sous le nom .env.production ou injectez ces variables dans
# votre console Cloudflare Pages / Nitro / Supabase.

# 1. URL PUBLIQUE DU SITE EN PRODUCTION
APP_URL=https://memoirepro.ga
VITE_APP_URL=https://memoirepro.ga

# 2. FIREBASE (Authentification, Base de données Cloud Firestore & Storage)
# À récupérer depuis votre Console Firebase > Paramètres du projet
VITE_FIREBASE_API_KEY=votre_cle_api_firebase
VITE_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=votre-projet-id
VITE_FIREBASE_STORAGE_BUCKET=votre-projet.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=votre_messaging_sender_id
VITE_FIREBASE_APP_ID=votre_app_id
VITE_FIREBASE_MEASUREMENT_ID=votre_measurement_id

FIREBASE_PROJECT_ID=votre-projet-id
FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
FIREBASE_STORAGE_BUCKET=votre-projet.firebasestorage.app

# 3. PASSERELLE DE PAIEMENT AIRTEL MONEY GABON (API OpenAPI BEAC)
# Obtenu après contractualisation B2B avec Airtel Gabon (Libreville)
AIRTEL_MONEY_ENV=production
AIRTEL_MONEY_CLIENT_ID=votre_client_id_airtel_gabon
AIRTEL_MONEY_CLIENT_SECRET=votre_client_secret_airtel_gabon
AIRTEL_MONEY_MERCHANT_PIN=votre_code_marchand_pin
AIRTEL_MONEY_CALLBACK_URL=https://memoirepro.ga/api/webhooks/airtel

# 4. PASSERELLE DE PAIEMENT MOOV MONEY (MOOV AFRICA GABON TELECOM)
# Obtenu après contractualisation B2B avec Moov Africa Gabon
MOOV_MONEY_ENV=production
MOOV_MONEY_MERCHANT_ID=votre_merchant_id_moov_gabon
MOOV_MONEY_API_KEY=votre_api_key_moov_gabon
MOOV_MONEY_CALLBACK_URL=https://memoirepro.ga/api/webhooks/moov

# 5. NOTIFICATIONS TRANSACTIONNELLES & WHATSAPP GABON
# Fournisseur SMS/WhatsApp Business Gabon
WHATSAPP_BUSINESS_PHONE=+24174000000
SUPPORT_EMAIL=contact@memoirepro.ga
DPO_EMAIL=dpo@memoirepro.ga
AUDIT_EMAIL=audit@memoirepro.ga

# 6. SÉCURITÉ & AUDIT ANTI-PLAGIAT
# Identifiant d'API pour vérification automatique Turnitin / Compilatio
TURNITIN_API_KEY=votre_cle_api_turnitin_academique
TURNITIN_ACCOUNT_ID=votre_id_compte_universitaire
